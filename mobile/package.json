{
  "name": "jajaego-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "자재GO Android/iOS 앱 컨테이너",
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "doctor": "cap doctor",
    "open:android": "cap open android",
    "run:android": "cap run android",
    "open:ios": "cap open ios",
    "run:ios": "cap run ios",
    "assets:splash": "node scripts/generate-splash-assets.mjs",
    "assets:icon": "node scripts/generate-icon-assets.mjs",
    "signing:create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-upload-key.ps1",
    "build:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed-release.ps1",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Variant debug",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Variant release"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2"
  }
}

# VPS container paths. These directories survive image rebuilds and restarts.
JAJAEGO_ENV_FILE=.env.vps
JAJAEGO_HOST_PORT=4173
JAJAEGO_DATA_DIR=/var/lib/jajaego/data
JAJAEGO_UPLOADS_DIR=/var/lib/jajaego/uploads
JAJAEGO_OUTPUTS_DIR=/var/lib/jajaego/outputs
JAJAEGO_IMAGE_TAG=latest

# Application
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
PUBLIC_SITE_URL=https://jajaego.example.com
APP_PUBLIC_URL=https://jajaego.example.com

# Administrator. Use a unique password of at least 16 characters.
ADMIN_USERNAME=replace_me
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_DISPLAY_NAME=내부관리자

# Supabase project: jajaego. Keep the service role key server-side only.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_BUSINESS_DOCUMENT_BUCKET=business-documents
SUPABASE_REQUEST_TIMEOUT_MS=12000

# Product reads: keep the local DB as a controlled fallback while Supabase remains primary.
PRODUCT_READ_MODE=remote-first
FORCE_LOCAL_PRODUCTS=false
PRODUCT_READ_CACHE_TTL_MS=300000
PRODUCT_READ_FALLBACK_CACHE_TTL_MS=60000
PRODUCT_REMOTE_READ_TIMEOUT_MS=20000

# OpenAI image search and photorealistic rendering
OPENAI_API_KEY=replace_me
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_RENDER_TIMEOUT_MS=300000
OPENAI_RENDER_SIZE=1536x1024
OPENAI_RENDER_QUALITY=high
OPENAI_RENDER_OUTPUT_FORMAT=jpeg
OPENAI_RENDER_OUTPUT_COMPRESSION=88

# Public stock display policy
PUBLIC_EXPOSE_ALL_STOCK_PRODUCTS=true
PUBLIC_STOCK_EXCLUDE_THRESHOLD_QTY=0
STOCK_INQUIRY_THRESHOLD_QTY=30

# OAuth providers. Add only the providers used in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
NAVER_LOGIN_REDIRECT_URI=https://jajaego.example.com

# Keep supplier crawling credentials off the public VPS. Vendor refresh remains manual-only.

  "performance": {
    "slipResistance": {
      "searchAliases": ["논슬립", "미끄럼방지", "anti-slip", "antislip", "non-slip", "slip-resistant", "grip"],
      "imageOnlyInferenceAllowed": false,
      "requiredEvidence": ["explicit_product_spec", "technical_sheet", "test_report"]
    },
    "imageOnlyInferenceForbidden": [
      "body_material",
      "water_absorption",
      "slip_rating",
      "dcof",
      "r_rating",
      "pei",
      "mohs",
      "breaking_strength",
      "frost_resistance",
      "chemical_resistance",
      "exact_size",
      "thickness",
      "rectification",
      "lot",
      "shade_code",
      "caliber"
    ]
  },
  "installationDimensions": {
    "surface": ["wall", "floor"],
    "environment": ["interior", "exterior", "wet", "submerged"],
    "space": ["bathroom", "kitchen", "entrance", "living", "commercial", "pool", "terrace"],
    "object": ["table", "countertop", "facade", "stair"]
  },
  "imageRoles": [
    "front_single",
    "front_multi_face",
    "detail_macro",
    "oblique_product",
    "installed_scene",
    "scale_with_person_or_object",
    "collection_composite",
    "packaging_or_sample",
    "render"
  ],
  "evidenceLevels": {
    "explicit_product_spec": 0.98,
    "manufacturer_collection_spec": 0.95,
    "retailer_structured_spec": 0.9,
    "product_title": 0.85,
    "category_context": 0.75,
    "marketing_copy": 0.65,
    "image_observation": 0.5
  },
  "decisionStates": ["accept", "partial", "abstain"],
  "abstainRules": [
    "tile_roi_too_small",
    "multiple_surfaces_without_dominant_target",
    "severe_blur_or_compression",
    "excessive_glare_or_clipping",
    "unreliable_white_balance",
    "perspective_not_rectifiable",
    "hard_filter_has_no_candidates",
    "visual_evidence_conflicts_with_selected_filters",
    "out_of_domain_surface",
    "top_results_are_not_stable"
  ]
